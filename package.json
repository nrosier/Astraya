{
  "name": "astraea",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Astrological calculation and charting webapp powered by the Swiss Ephemeris",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "ephe:sync": "node scripts/sync-ephemeris.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sweph-wasm": "2.6.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "astronomy-engine": "2.1.19",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
