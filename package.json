{
  "name": "astraya",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "description": "Astrological calculation and charting webapp powered by the Swiss Ephemeris",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "serve": "node server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "ephe:sync": "node scripts/sync-ephemeris.mjs",
    "corpus:split": "node scripts/split-corpus.mjs",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "corpus:similarity": "node scripts/corpus-similarity-report.mjs",
    "corpus:review-report": "node scripts/corpus-review-report.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "luxon": "^3.7.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sweph-wasm": "2.6.9",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.5",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "astronomy-engine": "2.1.19",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
