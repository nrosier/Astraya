# Astraya — environment template. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# This file is committed and must never contain a real value. `.env.local` is
# ignored by git and Docker; keep secrets only there.
#
# None of these are required to run, build or test the app. Astraya works fully
# offline with no configuration: calculation, charting and the report all run in
# the browser, and the interpretation corpus is committed as source data.

# --- Mode -------------------------------------------------------------------
# Astraya's build mode is Vite's own `mode` concept — selected with `--mode`, not
# a literal env var you export, but it does load a matching `.env.<mode>` file,
# which is why it's documented here. Each npm script already picks one:
#
#   npm run dev          -> development
#   npm run build        -> production   (what the Docker image ships)
#   npm test              -> test
#   npm run build:demo   -> demo         (see below)
#
# `demo` is a fourth mode, for a build with no server component at all: no
# sign-in, no sync, no `/api/*` calls of any kind. That's what runs at
# https://nrosier.github.io/Astraya/ — a fully static GitHub Pages deploy, so
# there's nothing there to have a server. `import.meta.env.MODE === 'demo'`
# gates that behaviour client-side (see src/demo-mode.ts).

# --- Base path (GitHub Pages / any subpath deploy) ---------------------------
# Root-relative ("/") by default. Set this when the app is served from a
# subpath rather than a domain's root — e.g. a GitHub Pages project site
# (https://nrosier.github.io/Astraya/ -> /Astraya/). VITE_-prefixed, but read by
# vite.config.ts itself (via loadEnv), not just exposed to the browser bundle:
# it sets Vite's `base`, so every built asset path, the service worker's own
# scope, and its precache manifest all agree with it. Must include both a
# leading and trailing slash.
# VITE_BASE_PATH=/Astraya/

# --- Google AI Studio (Gemini) — build-time corpus generation only (M7) ------
# Read exclusively by tools/corpus-gen/. The shipped app makes no LLM calls at
# runtime, and CI does not need a key because the corpus is committed.
# Key: https://aistudio.google.com/apikey
#
# Not VITE_-prefixed on purpose: Vite exposes only VITE_* to client code, so this
# name cannot reach the browser bundle.
GEMINI_API_KEY=
# Pin a version, never a `-latest` alias: an alias would silently change what
# produced the committed corpus. Verified 2026-09-07:
#   * `gemini-3.1-pro-preview` works, but needs billing enabled on the project —
#     the free tier's Pro limit is 0, not merely low.
#   * `gemini-3.8-flash` works and is a fine cheaper fallback for prompt iteration.
#   * `gemini-2.5-pro` is 404 for new keys — retired.
GEMINI_MODEL=gemini-3.1-pro-preview
# Temperature 0.7-0.8. High enough that 1,200 short fragments stay lexically
# varied, low enough to keep the negative constraints and the response schema
# honoured. Below ~0.6 the corpus starts repeating sentence shapes.
GEMINI_TEMPERATURE=0.75
# Fragments per request. Deliberately small despite the context window: asking for
# hundreds in one call drifts stylistically toward the end of the batch, and a
# schema violation costs the whole batch rather than 30 items.
GEMINI_BATCH_SIZE=30
GEMINI_MAX_CONCURRENCY=4
# Optional: leave empty for AI Studio, set to route via Vertex AI or a proxy.
GEMINI_BASE_URL=

# --- Sync server (M8) --------------------------------------------------------
# Only needed if you run the sync relay. Anonymous, local-only use needs neither.
#
# Where the SQLite database (accounts, sessions, the operation log) lives.
# Default shown; the Docker image already sets it. Must be on a writable,
# persistent volume — /app/data is otherwise the only writable path in the
# container, and is discarded with the container unless a volume is mounted
# there (`docker run -v astraya-data:/app/data ...`).
# ASTRAYA_DB_PATH=/app/data/astraya.db
#
# AES-256-GCM key for the operation payload column, 32 bytes base64:
#   openssl rand -base64 32
# Back this up SEPARATELY from the database. A backup holding both the key and the
# data is a backup with no encryption. Lose it and the stored ops are unreadable.
# Left blank, the server still starts and local accounts still work — only the
# sync relay (POST/GET /api/ops) is disabled, returning 503. Set but the wrong
# length, the server refuses to start rather than silently storing plaintext.
ASTRAYA_ENCRYPTION_KEY=

# Authentik OIDC. Public client, Authorization Code + PKCE — there is no client
# secret to configure, by design. The issuer is also the only external origin the
# CSP permits, so it must match exactly.
#
# In the Authentik provider, register the redirect URI as exactly
# ${ASTRAYA_PUBLIC_URL}/auth/oidc/callback (e.g. https://astraya.example.com/auth/oidc/callback)
# and the RP-initiated logout redirect as ${ASTRAYA_PUBLIC_URL}.
#
# A session started via Authentik gets a shorter sliding TTL (24h) than a local
# account's (30 days). This is a deliberate tradeoff, not an oversight: once the
# one-time sign-in exchange is done, Astraya has no way to notice an account
# being disabled or a session being revoked on the Authentik side — the shorter
# TTL bounds how long that gap can last.
ASTRAYA_OIDC_ISSUER=
ASTRAYA_OIDC_CLIENT_ID=
# This instance's own public URL, used to build the OIDC redirect_uri and to
# validate it server-side. Only needed behind a reverse proxy or when reachable
# on more than one domain — otherwise window.location.origin is enough. Must
# match exactly what's registered as the redirect URI in the Authentik provider.
ASTRAYA_PUBLIC_URL=

# --- Birth-place map tile server (#159, #267) --------------------------------
# The default, no-config setup needs none of these: the map uses OpenStreetMap's
# public tiles, no API key required. That default is fine for trying Astraya out,
# but OSM's tile server blocks production traffic it can't identify — a real
# deployment is expected to eventually trip that (#261, #267). Two independent
# fixes, pick one:
#
# Option A — a MapTiler Cloud API key. MapTiler authenticates by this key, not by
# the browser's Referer/Origin headers, so it is unaffected by this server's
# blanket `Referrer-Policy: no-referrer`. Free tier available; get a key at
# https://cloud.maptiler.com/account/keys/ . VITE_-prefixed: baked into the
# client bundle at build time, so rebuild the image after setting it.
# VITE_MAPTILER_API_KEY=
#
# Option B — self-host your own tile server. Set both of these together, to
# matching values — a mismatch fails closed (tiles blocked by the CSP), never
# open. Takes priority over VITE_MAPTILER_API_KEY above if both are set.
#
# VITE_-prefixed: baked into the client bundle at build time, so this is the URL
# template Leaflet actually requests tiles from. Must be a Leaflet-style
# {z}/{x}/{y} template.
# VITE_TILE_URL_TEMPLATE=https://tiles.example.com/{z}/{x}/{y}.png
#
# Scheme + host only, no path. Read server-side to grant that origin in img-src,
# replacing the default public OSM host there. Must be the exact origin
# VITE_TILE_URL_TEMPLATE points at — or, for Option A, exactly
# https://api.maptiler.com.
# ASTRAYA_TILE_ORIGIN=https://tiles.example.com
#
# Neither option configured: the app falls back to OSM's public tiles with a
# referrer-policy override on tile requests only (Leaflet's `referrerPolicy:
# 'origin'`), so OSM can still identify the requesting site despite the global
# no-referrer header above. This reduces but does not eliminate the risk of
# OSM's usage policy blocking a busier deployment — see #267.

# --- Birth-place geocoding (#291, #294, #290) ---------------------------------
# The "Fill in place name" button and the "Search for a place by name" field
# both need no setup either: by default they look up places against
# Nominatim's public reverse/forward-geocoding endpoints, no API key
# required — the two directions always share the same provider, configured
# together below. Nominatim only grants CORS to requests carrying a Referer,
# so these requests override this server's blanket no-referrer policy just for
# themselves, disclosing this site's origin to Nominatim (nothing more) — same
# trade-off as the tile fallback below. Two ways to avoid that disclosure and
# the same usage-policy risk as the default map tiles above:
#
# Option A — the same MapTiler Cloud API key as Option A above, reused as-is:
# MapTiler's Geocoding API authenticates by that key, not by Referer, so no
# referrer is ever sent. Nothing further to set here.
#
# Option B — self-host your own Nominatim-compatible server. Set both of these
# together, to matching values — a mismatch fails closed (the lookup blocked
# by the CSP), never open. Takes priority over VITE_MAPTILER_API_KEY if both
# are set.
#
# VITE_-prefixed: baked into the client bundle at build time, so this is the
# URL the client actually requests reverse-geocoding results from. Forward
# geocoding (#290) derives its own /search request from this same origin —
# no separate URL to set for it, since a "Nominatim-compatible" server is
# assumed to expose /search alongside /reverse, matching stock Nominatim.
# VITE_NOMINATIM_URL=https://nominatim.example.com/reverse
#
# Scheme + host only, no path. Read server-side to grant that origin in
# connect-src, replacing the default public Nominatim host there. Must be the
# exact origin VITE_NOMINATIM_URL points at — or, for Option A, exactly
# https://api.maptiler.com.
# ASTRAYA_GEOCODE_ORIGIN=https://nominatim.example.com

# --- Report personas (#62) ---------------------------------------------------
# The report's "Advisor" picker — five stylistic voices layered on top of the
# same neutral corpus. Off by default: personas are newer and less-reviewed
# than the neutral voice, so a deployer opts in rather than every build getting
# them for free. Off, the picker is hidden and the report always renders in the
# neutral voice, even on a device that already had a persona saved from before
# this toggle existed. VITE_-prefixed: baked into the client bundle at build
# time, so rebuild after changing it. Must be exactly the string "true".
# VITE_ENABLE_REPORT_PERSONAS=true

# --- Server runtime ----------------------------------------------------------
# Defaults shown; the Docker image already sets these.
# PORT=8080
# HOST=0.0.0.0
# LOG_LEVEL=info

# Unset (the default) means Fastify trusts no `X-Forwarded-For`/`X-Forwarded-Proto`
# header at all — every request is treated as arriving directly, which is correct
# with no reverse proxy in front of the server. Only set this if there IS one:
# otherwise a client can forge those headers to defeat per-IP rate limiting, or to
# claim `X-Forwarded-Proto: http` and get a session cookie minted without `Secure`.
# Set to a comma-separated list of the proxy's own IPs/CIDRs (e.g. 127.0.0.1 for a
# reverse proxy on the same host). No hop-count form: a bare number of hops can't be
# checked against who is actually connecting, so it isn't accepted.
# ASTRAYA_TRUST_PROXY=127.0.0.1
