{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    // A small closure of src/interpretation and src/astrology files (#360's
    // server/interpretation-routes.ts) is also loaded directly by Node's own
    // type stripping, which — unlike this project's `bundler` resolution —
    // never maps a `.js` specifier onto a sibling `.ts` file. Those files'
    // own internal imports of each other use explicit `.ts` extensions for
    // that reason (mirrors tsconfig.server.json's own use of this flag);
    // every other src/ import stays on the usual `.js` convention.
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
